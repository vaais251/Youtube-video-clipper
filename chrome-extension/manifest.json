{
  "manifest_version": 3,
  "name": "YouTube Clip Downloader",
  "version": "1.0.0",
  "description": "Select, name, and export multiple MP4 clips from the video you are watching.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["sidePanel", "nativeMessaging", "storage", "scripting"],
  "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://music.youtube.com/*"],
  "action": { "default_title": "Open YouTube Clip Downloader", "default_icon": "icon.png" },
  "icons": { "128": "icon.png" },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js" }
}
